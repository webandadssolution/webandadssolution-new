# Google reCAPTCHA v2 ("I'm not a robot" checkbox) site key.
# Get your real key at https://www.google.com/recaptcha/admin for this domain.
# The value below is Google's public TEST key — it always passes and shows a
# "for testing purposes only" notice, so replace it before going live.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Base URL of the Blog CMS (PHP admin panel). Read at build time (generateStaticParams
# fetches all posts to pre-render /[category]/[slug] pages).
# Local: http://localhost:8000 — Production: https://cms.webandadssolution.com
CMS_URL=http://localhost:8000

# Same CMS URL, but shipped to the browser. Used by the blog listing page (to live-refresh
# with posts published after the last build) and by the /blog-live and /author-live fallback
# pages that serve URLs the last build didn't know about yet. The CMS API is public and
# CORS-allowed for this site's origin, so exposing this is safe.
NEXT_PUBLIC_CMS_URL=http://localhost:8000
