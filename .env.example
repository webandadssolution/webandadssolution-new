# Base URL of the Blog CMS (PHP admin panel). Read at build time only (generateStaticParams
# fetches all posts to pre-render /[category]/[slug] pages), never shipped to the browser.
# Local: http://localhost:8000 — Production: https://cms.webandadssolution.com
CMS_URL=http://localhost:8000
